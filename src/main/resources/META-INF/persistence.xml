<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">
 <!--  se indica que se crea una unidad de persistencia EntidadesPU-->
   <persistence-unit name="EntidadesPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
 <!--  se indican las entidades-->
        <class>com.mycompany.entidades.modelo.Usuario</class>
        <class>com.mycompany.entidades.modelo.Persona</class>
        <class>com.mycompany.entidades.modelo.Domicilio</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://mysql:3306/entidades"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="entidades123"/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.MySQLDialect"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="none"/>

            <property name="hibernate.show_sql"
                      value="false"/>

            <property name="hibernate.format_sql"
                      value="false"/>

        </properties>

    </persistence-unit>

</persistence>